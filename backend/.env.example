# Server
PORT=3001
NODE_ENV=development

# The full URL where the app is running (used in email links)
# Development: http://localhost:5173
# Production: https://your-app.onrender.com
APP_URL=http://localhost:5173

# PostgreSQL connection string
# Development (local Postgres): postgresql://localhost/approvals
# Production (Neon): copy the connection string from your Neon dashboard
DATABASE_URL=postgresql://localhost/approvals

# A random secret to protect the reminder webhook
REMINDER_SECRET=change-this-to-a-random-string

# Microsoft Graph API (email)
MS_TENANT_ID=ad124d1e-4e29-4917-868e-87827d3250ca
MS_CLIENT_ID=7e64799b-2088-4d21-a0e9-96bd89f445e9
MS_CLIENT_SECRET=your-client-secret-from-lastpass
MS_SENDER_EMAIL=hiring@propellerindustries.com