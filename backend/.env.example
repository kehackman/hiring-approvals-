# Server
PORT=3001
NODE_ENV=development

# The full URL where the app is running (used in email links)
# Development: http://localhost:5173
# Production: https://yourdomain.com
APP_URL=http://localhost:5173

# SMTP Email Settings
# For Microsoft 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@yourcompany.com
SMTP_PASS=your-password

# The "From" address shown in emails
FROM_EMAIL=khackman@propellderindustries.com